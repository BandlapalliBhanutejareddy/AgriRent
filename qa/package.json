{
  "name": "agrorent-qa",
  "version": "1.0.0",
  "description": "AgroRent AI QA Automation Framework",
  "scripts": {
    "test:web": "mocha web-selenium/tests/**/*.spec.js --timeout 60000 --reporter mochawesome --reporter-options reportDir=reports/web,reportFilename=execution-report",
    "test:android": "wdio android-appium/config/wdio.conf.js",
    "test:cross": "mocha cross-platform/tests/**/*.spec.js --timeout 120000 --reporter mochawesome --reporter-options reportDir=reports/cross-platform,reportFilename=execution-report",
    "test:all": "npm run test:web && npm run test:android && npm run test:cross",
    "report:web": "node web-selenium/utils/generateExcel.js",
    "report:android": "node android-appium/utils/generateExcel.js",
    "report:cross": "node cross-platform/utils/generateExcel.js"
  },
  "dependencies": {
    "@wdio/appium-service": "^8.36.1",
    "@wdio/local-runner": "^8.36.1",
    "@wdio/mocha-framework": "^8.36.1",
    "chai": "^4.4.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "node-fetch": "^3.3.2",
    "playwright": "^1.62.1",
    "selenium-webdriver": "^4.20.0",
    "webdriverio": "^8.36.1",
    "xlsx": "^0.18.5"
  },
  "main": "generate_flutter_excel.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
