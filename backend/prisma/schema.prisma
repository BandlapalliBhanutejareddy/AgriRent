generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String           @id @default(cuid())
  phone             String?
  name              String
  createdAt         DateTime         @default(now())
  email             String           @unique
  password          String
  profileImage      String?
  role              String
  authId            String?          @unique
  isVerified        Boolean          @default(true)
  isSuspended       Boolean          @default(false)
  pushToken         String?
  preferredLanguage String           @default("en")
  bookings          Booking[]
  equipments        Equipment[]
  messages          Message[]
  notifications     Notification[]
  savedEquipment    SavedEquipment[]
  sessions          Session[]
  feedbacks         Feedback[]
  farms             Farm[]
}

model Equipment {
  id                 String           @id @default(cuid())
  category           String
  description        String
  pricePerDay        Float
  imageUrl           String
  ownerId            String
  createdAt          DateTime         @default(now())
  available          Boolean          @default(true)
  title              String
  location           String?
  latitude           Float?
  longitude          Float?
  titleEn            String?
  titleTe            String?
  titleHi            String?
  titleTa            String?
  titleKn            String?
  descriptionEn      String?
  descriptionTe      String?
  descriptionHi      String?
  descriptionTa      String?
  descriptionKn      String?
  translationVersion Int              @default(1)
  bookings           Booking[]
  owner              User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  savedEquipment     SavedEquipment[]
  reviews            EquipmentReview[]

  @@unique([title, ownerId])
  @@index([ownerId])
  @@index([category])
  @@index([createdAt])
}

model Booking {
  id                    String               @id @default(cuid())
  farmerId              String
  equipmentId           String
  startDate             DateTime
  endDate               DateTime
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  status                String               @default("PENDING")
  totalPrice            Float?
  amountPaid            Float?
  securityDeposit       Float?               @default(0)
  paymentId             String?
  paymentStatus         String               @default("PENDING")
  cancellationReason    String?
  equipment             Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  farmer                User                 @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  messages              Message[]
  payments              PaymentTransaction[]
  statusHistory         BookingStatusHistory[]
  returnInspection      ReturnInspection?
  equipmentReviews      EquipmentReview[]
  userReviews           UserReview[]
  complaints            Complaint[]

  @@index([farmerId])
  @@index([equipmentId])
  @@index([createdAt])
  @@index([status])
}

model BookingStatusHistory {
  id        String   @id @default(cuid())
  bookingId String
  status    String
  title     String?
  note      String?
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
}

model ReturnInspection {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  condition       String   @default("GOOD")
  deductionAmount Float    @default(0)
  notes           String?
  inspectedAt     DateTime @default(now())
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model EquipmentReview {
  id                String    @id @default(cuid())
  bookingId         String
  farmerId          String
  equipmentId       String
  rating            Int
  performanceRating Int?
  conditionRating   Int?
  cleanlinessRating Int?
  valueRating       Int?
  comment           String?
  createdAt         DateTime  @default(now())
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  equipment         Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([farmerId])
}

model UserReview {
  id                  String   @id @default(cuid())
  bookingId           String
  reviewerId          String
  revieweeId          String
  role                String   // "FARMER_RATING_OWNER" | "OWNER_RATING_FARMER"
  rating              Int
  behaviourRating     Int?
  communicationRating Int?
  timelinessRating    Int?
  comment             String?
  createdAt           DateTime @default(now())
  booking             Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([revieweeId])
  @@index([reviewerId])
}

model Complaint {
  id           String   @id @default(cuid())
  reporterId   String
  targetUserId String?
  bookingId    String?
  equipmentId  String?
  category     String
  description  String
  evidenceUrl  String?
  status       String   @default("NEW") // NEW, UNDER_REVIEW, ACTION_REQUIRED, RESOLVED, DISMISSED
  adminNotes   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  booking      Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

model OwnerVerification {
  id              String   @id @default(cuid())
  ownerId         String   @unique
  documentType    String
  documentUrl     String
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  relatedId String?
  type      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model SavedEquipment {
  id          String    @id @default(cuid())
  userId      String
  equipmentId String
  createdAt   DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, equipmentId])
}

model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([senderId])
  @@index([read])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  resource   String
  resourceId String?
  ip         String?
  userAgent  String?
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model FarmingGuide {
  id                   String   @id @default(cuid())
  cropName             String
  stepOrder            Int
  stepTitle            String
  description          String
  imageUrl             String
  smartTip             String
  recommendedEquipment String
  createdAt            DateTime @default(now())
}

model ModernTechnique {
  id                  String   @id @default(cuid())
  title               String
  description         String
  relatedCrop         String
  equipmentSuggestion String
  imageUrl            String
  createdAt           DateTime @default(now())
}

model OTPVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  purpose   String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  bookingId         String
  farmerId          String?
  ownerId           String?
  transactionRef    String   @unique @default(cuid())
  amount            Float
  currency          String   @default("INR")
  status            String
  paymentMethod     String?  @default("AGRORENT_DIRECT")
  invoiceUrl        String?
  refundedAmount    Float?
  failureReason     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  booking           Booking  @relation(fields: [bookingId], references: [id])
}

model Feedback {
  id            String   @id @default(cuid())
  userId        String
  rating        Int
  category      String
  subject       String?
  message       String
  attachmentUrl String?
  status        String   @default("PENDING")
  adminResponse String?
  activeRole    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

