// ============================================================

model Farm {
  id         String   @id @default(cuid())
  ownerId    String
  name       String
  location   String
  area       Float
  areaUnit   String   @default("acres")
  soilType   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner      User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  crops      FarmCrop[]
  risks      FarmRisk[]
  budgets    FarmBudget[]
  decisions  FarmDecision[]
  activities FarmActivity[]
  schedules  FarmSchedule[]
  memories   FarmMemory[]

  @@index([ownerId])
  @@index([createdAt])
}

model FarmCrop {
  id                  String    @id @default(cuid())
  farmId              String
  cropName            String
  variety             String?
  season              String
  stage               String
  sowingDate          DateTime?
  expectedHarvestDate DateTime?
  status              String    @default("ACTIVE")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  farm       Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  operations FarmOperation[]
  risks      FarmRisk[]
  budgets    FarmBudget[]
  decisions  FarmDecision[]

  @@index([farmId])
  @@index([status])
}

model FarmOperation {
  id                  String    @id @default(cuid())
  farmCropId          String
  name                String
  description         String?
  status              String    @default("PLANNED")
  plannedStartDate    DateTime?
  plannedEndDate      DateTime?
  completedAt         DateTime?
  labourersNeeded     Int?
  labourersAvailable  Int?
  estimatedLabourCost Float?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  crop  FarmCrop   @relation(fields: [farmCropId], references: [id], onDelete: Cascade)
  tasks FarmTask[]
  risks FarmRisk[]

  @@index([farmCropId])
  @@index([status])
}

model FarmTask {
  id          String    @id @default(cuid())
  operationId String
  title       String
  description String?
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  operation FarmOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)

  @@index([operationId])
  @@index([status])
}

model FarmRisk {
  id          String    @id @default(cuid())
  farmId      String
  farmCropId  String?
  operationId String?
  type        String
  severity    String    @default("MEDIUM")
  title       String
  description String
  status      String    @default("OPEN")
  detectedAt  DateTime  @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  farm      Farm           @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop      FarmCrop?      @relation(fields: [farmCropId], references: [id], onDelete: SetNull)
  operation FarmOperation? @relation(fields: [operationId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([status])
}

model FarmBudget {
  id             String    @id @default(cuid())
  farmId         String
  farmCropId     String?
  totalBudget    Decimal   @db.Decimal(12, 2)
  spentAmount    Decimal   @default(0) @db.Decimal(12, 2)
  reservedAmount Decimal   @default(0) @db.Decimal(12, 2)
  currency       String    @default("INR")
  periodStart    DateTime?
  periodEnd      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  farm Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop FarmCrop? @relation(fields: [farmCropId], references: [id], onDelete: SetNull)

  @@index([farmId])
}

model FarmDecision {
  id         String   @id @default(cuid())
  farmId     String
  farmCropId String?
  type       String
  title      String
  decision   String
  reasoning  String?
  language   String   @default("en")
  source     String   @default("SYSTEM")
  createdAt  DateTime @default(now())

  farm Farm      @relation(fields: [farmId], references: [id], onDelete: Cascade)
  crop FarmCrop? @relation(fields: [farmCropId], references: [id], onDelete: SetNull)

  @@index([farmId])
  @@index([createdAt])
}

model FarmActivity {
  id          String   @id @default(cuid())
  farmId      String
  actorId     String?
  type        String
  title       String
  description String?
  metadata    String?
  createdAt   DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([createdAt])
}

// Append-only farm history used as an advisory signal by deterministic engines.
model FarmMemory {
  id          String   @id @default(cuid())
  farmId      String
  actorId     String?
  eventType   String
  subjectType String?
  subjectId   String?
  payload     String
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId, occurredAt])
  @@index([farmId, eventType])
  @@index([subjectType, subjectId])
}

model FarmSchedule {
  id                 String             @id @default(cuid())
  farmId             String
  status             String             @default("DRAFT") // DRAFT, FINALIZED, ARCHIVED
  qualityScore       Int                @default(0)
  totalEstimatedCost Decimal            @default(0) @db.Decimal(12, 2)
  summary            String?
  language           String             @default("en")
  createdBy          String?
  finalizedAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  farm               Farm               @relation(fields: [farmId], references: [id], onDelete: Cascade)
  items              FarmScheduleItem[]

  @@index([farmId])
  @@index([createdAt])
}

model FarmScheduleItem {
  id               String       @id @default(cuid())
  scheduleId       String
  operationId      String?
  equipmentId      String?
  operationName    String
  stage            String
  priority         String       @default("MEDIUM")
  plannedStartDate DateTime
  plannedEndDate   DateTime
  durationDays     Int          @default(1)
  estimatedCost    Float        @default(0)
  decisionScore    Int          @default(0)
  riskScore        Int          @default(0)
  status           String       @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, BLOCKED
  conflictStatus   String       @default("NONE")
  reason           String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  schedule         FarmSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([scheduleId])
}
