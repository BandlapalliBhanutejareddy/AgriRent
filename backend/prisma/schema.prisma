generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String           @id @default(cuid())
  phone            String?          @unique
  name             String?
  role             String
  location         String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  authId           String?          @unique
  email            String?          @unique
  bookingsAsFarmer Booking[]        @relation("FarmerBookings")
  bookingsAsOwner  Booking[]        @relation("OwnerBookings")
  messagesRecv     ChatMessage[]    @relation("MessagesReceived")
  messagesSent     ChatMessage[]    @relation("MessagesSent")
  equipment        Equipment[]
  notifications    Notification[]
  savedEquipment   SavedEquipment[]
}

model Equipment {
  id             String           @id @default(cuid())
  name           String
  category       String
  description    String?
  pricePerDay    Float
  isAvailable    Boolean          @default(true)
  imageUrl       String?
  ownerId        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  location       String?
  isDeleted      Boolean          @default(false)
  deletedAt      DateTime?
  bookings       Booking[]
  owner          User             @relation(fields: [ownerId], references: [id])
  savedEquipment SavedEquipment[]

  @@index([ownerId])
  @@index([category, location])
}

model Booking {
  id           String        @id @default(cuid())
  farmerId     String
  ownerId      String
  equipmentId  String
  startDate    DateTime
  endDate      DateTime
  totalPrice   Float
  status       String
  isDeleted    Boolean       @default(false)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  equipment    Equipment     @relation(fields: [equipmentId], references: [id])
  farmer       User          @relation("FarmerBookings", fields: [farmerId], references: [id])
  owner        User          @relation("OwnerBookings", fields: [ownerId], references: [id])
  chatMessages ChatMessage[]

  @@index([farmerId])
  @@index([ownerId])
  @@index([status])
}

model SavedEquipment {
  id          String    @id @default(cuid())
  userId      String
  equipmentId String
  createdAt   DateTime  @default(now())
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, equipmentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String
  relatedId String?
  isDeleted Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ChatMessage {
  id         String   @id @default(cuid())
  bookingId  String
  senderId   String
  receiverId String
  message    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  receiver   User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id])
}

model FarmingGuide {
  id                   String   @id @default(cuid())
  cropName             String
  stepTitle            String
  description          String
  imageUrl             String?
  stepOrder            Int
  smartTip             String?
  recommendedEquipment String?
  createdAt            DateTime @default(now())
}

model ModernTechnique {
  id                  String   @id @default(cuid())
  title               String
  description         String
  imageUrl            String?
  relatedCrop         String
  equipmentSuggestion String?
  createdAt           DateTime @default(now())
}
