{
  "dependencies": {
    "axios": "^1.20.0",
    "playwright": "^1.62.1",
    "selenium-webdriver": "^4.51.0",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "build": "cd backend && npm install && npx prisma generate && npm run build",
    "start": "cd backend && npm start",
    "dev:web": "cd web && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "test:web": "python tests/selenium/test_selenium.py",
    "test:mobile": "python tests/appium/test_appium.py",
    "test:api": "node backend/tests/run_api_tests.js",
    "test:backend": "cd backend && npm run verify",
    "test:load": "python tests/load/run_load_test.py",
    "test:security": "python tests/dast/test_dast.py",
    "test:bundle": "python tests/bundle_reports.py",
    "test": "npm run test:web && npm run test:mobile && npm run test:load && npm run test:security && npm run test:bundle"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
